<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 440" width="100%" height="100%">
  <defs>
    <!-- Avatar Gradient -->
    <linearGradient id="avatarGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4c4168" />
      <stop offset="100%" stop-color="#2c253d" />
    </linearGradient>

    <!-- Subtle Glow -->
    <filter id="cardGlow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#000000" flood-opacity="0.6" />
    </filter>
  </defs>

  <!-- AMOLED Black Background -->
  <rect width="680" height="440" fill="#000000" rx="32" />

  <!-- Top Navigation Bar -->
  <g transform="translate(32, 28)">
    <!-- Edit Button Pill -->
    <rect x="0" y="0" width="88" height="44" rx="22" fill="#1c1c1e" />
    <text x="44" y="28" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="18" font-weight="500" fill="#ffffff">
      Edit
    </text>

    <!-- Center Segmented Control: All / Missed -->
    <g transform="translate(196, 0)">
      <rect x="0" y="0" width="200" height="44" rx="22" fill="#1c1c1e" />
      <!-- Selected 'All' segment -->
      <rect x="4" y="4" width="94" height="36" rx="18" fill="#3a3a3c" />
      <text x="51" y="27" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="16" font-weight="600" fill="#ffffff">
        All
      </text>
      <text x="149" y="27" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="16" font-weight="500" fill="#8e8e93">
        Missed
      </text>
    </g>

    <!-- Right Circle Button with Badge '2' -->
    <g transform="translate(540, 0)">
      <circle cx="22" cy="22" r="22" fill="#1c1c1e" />
      <!-- Hamburger Icon lines -->
      <line x1="12" y1="16" x2="32" y2="16" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
      <line x1="12" y1="22" x2="32" y2="22" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
      <line x1="12" y1="28" x2="26" y2="28" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
      
      <!-- Notification Badge -->
      <circle cx="36" cy="6" r="13" fill="#007aff" />
      <text x="36" y="11" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="14" font-weight="700" fill="#ffffff">
        2
      </text>
    </g>
  </g>

  <!-- Large Title: Recents -->
  <text x="32" y="142" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif" font-size="42" font-weight="800" fill="#ffffff" letter-spacing="-0.5">
    Recents
  </text>

  <!-- Search Bar Capsule -->
  <g transform="translate(32, 172)">
    <rect x="0" y="0" width="616" height="52" rx="16" fill="#1c1c1e" />
    
    <!-- Search Magnifier Icon -->
    <g transform="translate(20, 16)" stroke="#8e8e93" stroke-width="2.5" fill="none">
      <circle cx="7" cy="7" r="6" />
      <line x1="11.5" y1="11.5" x2="17" y2="17" stroke-linecap="round" />
    </g>

    <!-- Search Text -->
    <text x="54" y="32" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="19" font-weight="400" fill="#8e8e93">
      Search
    </text>

    <!-- Microphone Icon -->
    <g transform="translate(572, 14)">
      <rect x="7" y="3" width="8" height="13" rx="4" fill="#8e8e93" />
      <path d="M 4 11 A 7 7 0 0 0 18 11" fill="none" stroke="#8e8e93" stroke-width="2" stroke-linecap="round" />
      <line x1="11" y1="18" x2="11" y2="22" stroke="#8e8e93" stroke-width="2" stroke-linecap="round" />
      <line x1="8" y1="22" x2="14" y2="22" stroke="#8e8e93" stroke-width="2" stroke-linecap="round" />
    </g>
  </g>

  <!-- Contact Call Log Item: Shajer -->
  <g transform="translate(32, 280)">
    <!-- Contact Avatar -->
    <g>
      <circle cx="36" cy="36" r="36" fill="url(#avatarGrad)" />
      <!-- Head -->
      <circle cx="36" cy="27" r="12" fill="#ffffff" />
      <!-- Shoulders Clip -->
      <path d="M 17 56 A 20 20 0 0 1 55 56 Z" fill="#ffffff" />
    </g>

    <!-- Contact Name in Red (Missed Call) -->
    <text x="94" y="30" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="25" font-weight="600" fill="#ff453a" letter-spacing="-0.2">
      shajer
    </text>

    <!-- Call Subtitle: ↙ Instagram Video -->
    <g transform="translate(94, 50)">
      <!-- Incoming arrow icon -->
      <path d="M 12 2 L 2 12 M 2 12 L 10 12 M 2 12 L 2 4" fill="none" stroke="#8e8e93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <text x="20" y="11" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="18" font-weight="400" fill="#8e8e93">
        Instagram Video
      </text>
    </g>

    <!-- Call Timestamp: 10:58 PM -->
    <text x="510" y="42" text-anchor="end" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="18" font-weight="400" fill="#8e8e93">
      10:58 PM
    </text>

    <!-- iOS Info Icon: (i) in Blue -->
    <g transform="translate(548, 14)">
      <circle cx="22" cy="22" r="22" fill="none" stroke="#0a84ff" stroke-width="2" />
      <text x="22" y="28" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif" font-size="19" font-weight="600" fill="#0a84ff">
        i
      </text>
    </g>

    <!-- Separator Line -->
    <line x1="94" y1="84" x2="616" y2="84" stroke="#1c1c1e" stroke-width="1" />
  </g>
</svg>
